{
  "schema": "gocar.corpus.config.v1",
  "contract": {
    "id": "gpui",
    "description": "GPUI, Zed's GPU-accelerated UI framework — contract across its crates.io forks"
  },
  "recommended_provider": "gpui-unofficial",
  "providers": [
    {
      "id": "gpui",
      "package": "gpui",
      "lib_name": "gpui",
      "repository": null,
      "note": "registry releases in the 0.2.x era, including -test tags; provenance unattested",
      "sources": [
        { "kind": "crates-io", "index_path": "gp/ui/gpui" }
      ]
    },
    {
      "id": "gpui-ce",
      "package": "gpui-ce",
      "lib_name": "gpui",
      "repository": "https://github.com/gpui-ce/gpui-ce",
      "note": "Community Edition fork; pinned git revision is the current cargo-gpui 'gpui-ce' backend",
      "sources": [
        { "kind": "crates-io", "index_path": "gp/ui/gpui-ce" }
      ]
    },
    {
      "id": "gpui-unofficial",
      "package": "gpui-unofficial",
      "lib_name": "gpui",
      "repository": null,
      "note": "crates.io republish stream of zed gpui main; default backend of cargo-gpui",
      "sources": [
        { "kind": "crates-io", "index_path": "gp/ui/gpui-unofficial" }
      ]
    },
    {
      "id": "gpui-pre",
      "package": "gpui-pre",
      "lib_name": "gpui",
      "repository": null,
      "note": "pre-release tracking fork",
      "sources": [
        { "kind": "crates-io", "index_path": "gp/ui/gpui-pre" }
      ]
    },
    {
      "id": "kael",
      "package": "kael",
      "lib_name": "gpui",
      "repository": null,
      "note": "independent fork",
      "sources": [
        { "kind": "crates-io", "index_path": "ka/el/kael" }
      ]
    },
    {
      "id": "gpui-box",
      "package": "gpui-box",
      "lib_name": "gpui",
      "repository": null,
      "note": "boxed/contained fork",
      "sources": [
        { "kind": "crates-io", "index_path": "gp/ui/gpui-box" }
      ]
    },
    {
      "id": "gpui-fast",
      "package": "gpui-fast",
      "lib_name": "gpui",
      "repository": "https://github.com/longbridge/gpui-fast",
      "note": "Longbridge performance fork: gpui extracted as a standalone workspace with rendering/layout reuse optimizations; publishes the drop-in gpui library under the gpui-fast package",
      "sources": [
        { "kind": "crates-io", "index_path": "gp/ui/gpui-fast" }
      ]
    },
    {
      "id": "bite-gpui",
      "package": "bite-gpui",
      "lib_name": "gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "facade repack of upstream zed gpui into bite-gpui plus bite-gp-* layer crates; publishes the drop-in gpui library",
      "exclude": ["0.0.0-reserved"],
      "surface_source": {
        "kind": "reexports",
        "from": ["bite-gp-authoring", "bite-gp-runtime"]
      },
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gpui" }
      ]
    },
    {
      "id": "bite-gp-authoring",
      "package": "bite-gp-authoring",
      "lib_name": "gpui_authoring",
      "role": "dependency",
      "for": "bite-gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "bite-gpui layer crate: authoring tier (App, Window, elements) re-exported by the facade",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-authoring" }
      ]
    },
    {
      "id": "bite-gp-runtime",
      "package": "bite-gp-runtime",
      "lib_name": "gpui_runtime",
      "role": "dependency",
      "for": "bite-gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "bite-gpui layer crate: process harness (Application) re-exported by the facade",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-runtime" }
      ]
    },
    {
      "id": "bite-gp-engine",
      "package": "bite-gp-engine",
      "lib_name": "gpui_engine",
      "role": "dependency",
      "for": "bite-gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "bite-gpui layer crate: engine contracts (layout, text, scene, render) re-exported through the authoring tier",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-engine" }
      ]
    },
    {
      "id": "bite-gp-engine-default",
      "package": "bite-gp-engine-default",
      "lib_name": "gpui_engine_default",
