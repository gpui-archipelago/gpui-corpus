      "note": "bite-gpui layer crate: default engine implementations re-exported through the authoring tier",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-engine-default" }
      ]
    },
    {
      "id": "bite-gp-platform",
      "package": "bite-gp-platform",
      "lib_name": "gpui_platform",
      "role": "dependency",
      "for": "bite-gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "bite-gpui layer crate: platform SPI and window/display types re-exported through the authoring tier",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-platform" }
      ]
    },
    {
      "id": "bite-gp-gpui-util",
      "package": "bite-gp-gpui-util",
      "lib_name": "gpui_util",
      "role": "dependency",
      "for": "bite-gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "bite-gpui layer crate: shared utility types re-exported through the authoring tier",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-gpui-util" }
      ]
    },
    {
      "id": "bite-gp-refineable",
      "package": "bite-gp-refineable",
      "lib_name": "refineable",
      "role": "dependency",
      "for": "bite-gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "bite-gpui layer crate: the Refineable trait re-exported through the authoring tier",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-refineable" }
      ]
    },
    {
      "id": "bite-gp-types",
      "package": "bite-gp-types",
      "lib_name": "gpui_types",
      "role": "dependency",
      "for": "bite-gpui",
      "repository": "https://github.com/bite-gpui/bite-gpui",
      "note": "bite-gpui layer crate: platform-agnostic geometry, color, input and style types re-exported through the platform SPI",
      "sources": [
        { "kind": "crates-io", "index_path": "bi/te/bite-gp-types" }
      ]
